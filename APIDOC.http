#------------------ ACCOUNT REG ----------------------#

# api call to register user
###
POST http://127.0.0.1:8000/user/register/
Content-Type: application/json

{
    "username":"vishnu",
    "email":"vishnu@gmail.com",
    "password":"vishnu@123",
    "age":22,
    "height":173,
    "weight":56,
    "dob":"2004-07-07",
    "phone":"9037011230"

}


#------------------ CALORIES ----------------------#

# api call to list 
###
GET  http://127.0.0.1:8000/calories/
Accept : application/json
Authorization: Basic vishnu:vishnu@123

# api call to create 
###
POST   http://127.0.0.1:8000/calories/
Content-Type:  application/json
Authorization: Basic vishnu:vishnu@123

{
    "title":"Pork",
    "serving_size":"1",
    "calorie":360,
    "meal_type":"lunch"
}

# api call to retreieve 
###
GET  http://127.0.0.1:8000/calories/1/
Accept : application/json
Authorization: Basic vishnu:vishnu@123

# api call to update 
###
PUT   http://127.0.0.1:8000/calories/1/
Content-Type:  application/json
Authorization: Basic vishnu:vishnu@123

{
  "id": 1,
  "title": "Pork Dry Fry",
  "serving_size": "1",
  "calorie": 360.0,
  "meal_type": "lunch",
  "food_image": null,
  "created_at": "2026-11-12T11:18:34.994428Z",
  "owner": 1
}

# api call to delete 
###
DELETE  http://127.0.0.1:8000/calories/1/

Authorization: Basic vishnu:vishnu@123



